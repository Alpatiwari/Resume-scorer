# Copy this file to backend/.env and fill in your own values.
# NEVER commit the real .env file.

# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/resume_scorer
REDIS_URL=redis://localhost:6379/0

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Optional (defaults shown where they exist) ---------------------------
# Gemini model to use. Pick one your key has quota for (check Google AI Studio).
# Leave this line commented out to use the default from app/config.py.
# RESUME_SCORER_GEMINI_MODEL=your-model-name
# RESUME_SCORER_GEMINI_FALLBACK_MODELS=backup-model-1,backup-model-2

# RESUME_SCORER_GEMINI_TIMEOUT_MS=20000
# Lower this (for example 1 or 2) on a free-tier key to avoid rate limits.
# RESUME_SCORER_SCORING_CONCURRENCY=5

# false = if Gemini fails for every resume, fail the run and save nothing.
# true  = save keyword/semantic-only scores, flagged with a warning.
# RESUME_SCORER_ALLOW_DEGRADED_SCORING=false

# Your frontend address(es), comma separated. Change this when you deploy.
# RESUME_SCORER_CORS_ORIGINS=http://localhost:5173

# Set to false to close public sign-ups (create accounts with create_user.py).
# RESUME_SCORER_ALLOW_REGISTRATION=true
